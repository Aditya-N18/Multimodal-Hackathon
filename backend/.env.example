# InsForge (required for production without .insforge/project.json)
# INSFORGE_URL=https://your-project.us-west.insforge.app
# INSFORGE_API_KEY=ik_...

# Nebius Token Factory — required for real photo analysis
# Get key: https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_key_here

# Optional vision model override (default: Qwen/Qwen2.5-VL-72B-Instruct)
# NEBIUS_VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct

# Server
# PORT=3001
# UPLOAD_BASE_URL=https://your-api.fly.dev
# API_BASE_URL=https://your-api.fly.dev
