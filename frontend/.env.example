# Get these from Person B / InsForge dashboard
# URL: oss_host from .insforge/project.json
# Key: npx @insforge/cli secrets get ANON_KEY
VITE_INSFORGE_URL=https://your-app.us-east.insforge.app
VITE_INSFORGE_ANON_KEY=your-anon-key

# Realtime channel + event — confirm with Person B (defaults match architecture doc)
VITE_REALTIME_CHANNEL=incidents
VITE_REALTIME_EVENT=incident_updated

# Vapi — Dashboard → API Keys (public) + Assistants → assistant ID
VITE_VAPI_PUBLIC_KEY=your-vapi-public-key
VITE_VAPI_ASSISTANT_ID=your-assistant-id

# Photo upload API (Fly.dev backend)
VITE_UPLOAD_API_BASE=https://evidenceline-api-0e3b962d-641e-40eb-9df9-2e78323ae83a.fly.dev
